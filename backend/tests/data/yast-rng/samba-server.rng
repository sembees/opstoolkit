<?xml version="1.0" encoding="UTF-8"?>
<grammar ns="http://www.suse.com/1.0/yast2ns" xmlns:config="http://www.suse.com/1.0/configns" xmlns="http://relaxng.org/ns/structure/1.0">
  <include href="common.rng"/>
  <define name="workgroup">
    <element name="workgroup">
      <ref name="STRING"/>
    </element>
  </define>
  <define name="accounts">
    <element name="accounts">
      <ref name="LIST"/>
      <zeroOrMore>
        <element name="account">
          <ref name="STRING"/>
        </element>
      </zeroOrMore>
    </element>
  </define>
  <define name="samba-server">
    <element name="samba-server">
      <ref name="MAP"/>
      <interleave>
        <optional>
          <ref name="accounts"/>
        </optional>
        <optional>
          <element name="backend">
            <zeroOrMore>
              <element name="fixme">
                <ref name="STRING"/>
              </element>
            </zeroOrMore>
          </element>
        </optional>
        <optional>
          <element name="config">
            <interleave>
              <optional>
                <!--
                  WTF, this should be a "LIST", but
                  https://github.com/yast/yast-samba-client/blob/cfd7b2c61b1cae9df1035ea8399fb10213ea0c99/src/modules/SambaConfig.pm#L536
                  allows a hash
                -->
                <attribute name="config:type"/>
              </optional>
              <optional>
                <element name="comment">
                  <ref name="STRING"/>
                </element>
              </optional>
              <zeroOrMore>
                <element name="listentry">
                  <ref name="MAP"/>
                  <interleave>
                    <optional>
                      <element name="disabled">
                        <ref name="BOOLEAN"/>
                      </element>
                    </optional>
                    <optional>
                      <element name="name">
                        <ref name="STRING"/>
                      </element>
                    </optional>
                    <optional>
