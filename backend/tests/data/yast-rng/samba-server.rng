  <define name="role">
    <element name="role">
      <ref name="STRING"/>
    </element>
  </define>
  <define name="version">
    <element name="version">
      <ref name="STRING"/>
    </element>
  </define>
  <define name="shares">
    <element name="shares">
      <ref name="LIST"/>
      <zeroOrMore>
        <ref name="share"/>
      </zeroOrMore>
    </element>
  </define>
  <define name="trusteddomains">
    <element name="trusteddomains">
      <zeroOrMore>
        <ref name="trusteddomain"/>
      </zeroOrMore>
    </element>
  </define>
  <define name="trusteddomain">
    <element name="trusteddomain">
      <ref name="MAP"/>
      <ref name="trusteddomain_domain"/>
      <ref name="trusteddomain_password"/>
    </element>
  </define>
  <define name="trusteddomain_domain">
    <element name="domain">
      <ref name="STRING"/>
    </element>
  </define>
  <define name="trusteddomain_password">
    <element name="password">
      <ref name="STRING"/>
    </element>
  </define>
  <define name="y2_share">
    <choice>
      <ref name="samba_options"/>
      <ref name="share"/>
    </choice>
  </define>
  <define name="samba_options">
    <element name="options">
      <ref name="MAP"/>
      <zeroOrMore>
        <element name="option">
          <ref name="MAP"/>
          <ref name="samba_option_key"/>
          <optional>
            <ref name="samba_option_val"/>
          </optional>
        </element>
      </zeroOrMore>
    </element>
  </define>
  <define name="share">
    <element name="share">
      <zeroOrMore>
        <choice>
          <text/>
          <ref name="y2_share"/>
        </choice>
      </zeroOrMore>
    </element>
  </define>
  <define name="samba_option_key">
    <element name="key">
      <ref name="STRING"/>
    </element>
  </define>
  <define name="samba_option_val">
    <element name="value">
      <ref name="STRING"/>
    </element>
  </define>
</grammar>
