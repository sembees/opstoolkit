<?xml version="1.0" encoding="UTF-8"?>
<grammar xmlns="http://relaxng.org/ns/structure/1.0">
  <include href="common.rng"/>
  <define name="nis">
    <element name="nis">
      <ref name="MAP"/>
      <interleave>
        <optional>
          <element name="start_nis">
            <ref name="BOOLEAN"/>
          </element>
        </optional>
        <optional>
          <element name="netconfig_policy">
            <ref name="STRING"/>
          </element>
        </optional>
        <optional>
          <ref name="nis_domain"/>
        </optional>
        <optional>
          <!-- may be set by dhcp -->
          <ref name="nis_servers"/>
        </optional>
        <optional>
          <ref name="nis_broadcast"/>
        </optional>
        <optional>
          <element name="nis_other_domains">
            <ref name="LIST"/>
            <zeroOrMore>
              <element name="nis_other_domain">
                <ref name="MAP"/>
                <interleave>
                  <ref name="nis_domain"/>
                  <optional>
                    <!-- here it is mandatory -->
                    <ref name="nis_servers"/>
                  </optional>
                  <optional>
                    <ref name="nis_broadcast"/>
                  </optional>
                </interleave>
              </element>
            </zeroOrMore>
          </element>
        </optional>
        <optional>
          <element name="nis_broken_server">
            <ref name="BOOLEAN"/>
          </element>
        </optional>
        <optional>
          <element name="nis_local_only">
            <ref name="BOOLEAN"/>
          </element>
        </optional>
        <optional>
          <element name="nis_options">
            <ref name="STRING"/>
          </element>
        </optional>
        <optional>
          <element name="start_autofs">
            <ref name="BOOLEAN"/>
          </element>
        </optional>
        <optional>
          <element name="slp_domain">
            <optional>
              <ref name="Anything"/>
            </optional>
          </element>
        </optional>
      </interleave>
    </element>
  </define>
  <define name="nis_domain">
    <element name="nis_domain">
      <ref name="STRING"/>
    </element>
  </define>
  <define name="nis_servers">
    <element name="nis_servers">
      <ref name="LIST"/>
      <zeroOrMore>
        <element name="nis_server">
          <ref name="STRING"/>
        </element>
      </zeroOrMore>
    </element>
  </define>
  <define name="nis_broadcast">
    <element name="nis_broadcast">
      <ref name="BOOLEAN"/>
    </element>
  </define>
</grammar>
