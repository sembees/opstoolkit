<?xml version="1.0" encoding="UTF-8"?>
<grammar ns="http://www.suse.com/1.0/yast2ns" xmlns="http://relaxng.org/ns/structure/1.0">
  <include href="common.rng"/>
  <define name="ssh_import">
    <element name="ssh_import">
      <ref name="MAP"/>
      <interleave>
        <optional>
          <element name="import">
            <ref name="BOOLEAN"/>
          </element>
        </optional>
        <optional>
          <element name="copy_config">
            <ref name="BOOLEAN"/>
          </element>
        </optional>
        <optional>
          <element name="device">
            <ref name="STRING"/>
          </element>
        </optional>
      </interleave>
    </element>
  </define>
</grammar>
