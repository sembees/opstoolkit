<?xml version="1.0" encoding="UTF-8"?>
<grammar ns="http://www.suse.com/1.0/yast2ns" xmlns="http://relaxng.org/ns/structure/1.0">
  <include href="common.rng"/>
  <define name="samba-client">
    <element name="samba-client">
      <ref name="MAP"/>
      <interleave>
        <optional>
          <element name="active_directory">
            <ref name="MAP"/>
            <optional>
              <element name="kdc">
                <ref name="STRING"/>
              </element>
            </optional>
          </element>
        </optional>
        <optional>
          <element name="global">
            <ref name="MAP"/>
            <interleave>
              <optional>
                <element name="cups_options">
                  <ref name="STRING"/>
                </element>
              </optional>
              <optional>
                <element name="include">
                  <ref name="STRING"/>
                </element>
              </optional>
              <optional>
                <element name="logon_drive">
                  <ref name="STRING"/>
                </element>
              </optional>
              <optional>
                <element name="logon_home">
                  <ref name="STRING"/>
                </element>
              </optional>
              <optional>
