            </interleave>
          </element>
        </optional>
        <optional>
          <element name="printers">
            <ref name="MAP"/>
            <interleave>
              <optional>
                <element name="browseable">
                  <ref name="STRING"/>
                </element>
              </optional>
              <optional>
                <element name="comment">
                  <ref name="STRING"/>
                </element>
              </optional>
              <optional>
                <element name="create_mask">
                  <ref name="STRING"/>
                </element>
              </optional>
              <optional>
                <element name="path">
                  <ref name="STRING"/>
                </element>
              </optional>
              <optional>
                <element name="printable">
                  <ref name="STRING"/>
                </element>
              </optional>
            </interleave>
          </element>
        </optional>
        <optional>
          <element name="profiles">
            <ref name="MAP"/>
            <interleave>
              <optional>
                <element name="comment">
                  <ref name="STRING"/>
                </element>
              </optional>
              <optional>
                <element name="create_mask">
                  <ref name="STRING"/>
                </element>
              </optional>
              <optional>
                <element name="directory_mask">
                  <ref name="STRING"/>
                </element>
              </optional>
              <optional>
                <element name="path">
                  <ref name="STRING"/>
                </element>
              </optional>
              <optional>
                <element name="read_only">
                  <ref name="STRING"/>
                </element>
              </optional>
              <optional>
                <element name="store_dos_attributes">
