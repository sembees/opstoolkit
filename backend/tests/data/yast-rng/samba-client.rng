              </optional>
              <optional>
                <element name="inherit_acls">
                  <ref name="STRING"/>
                </element>
              </optional>
              <optional>
                <element name="path">
                  <ref name="STRING"/>
                </element>
              </optional>
              <optional>
                <element name="read_only">
                  <ref name="STRING"/>
                </element>
              </optional>
            </interleave>
          </element>
        </optional>
        <optional>
          <element name="homes">
            <ref name="MAP"/>
            <interleave>
              <optional>
                <element name="browseable">
                  <ref name="STRING"/>
