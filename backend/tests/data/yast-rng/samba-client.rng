                </element>
              </optional>
            </interleave>
          </element>
        </optional>
        <optional>
          <element name="users">
            <ref name="MAP"/>
            <interleave>
              <optional>
                <element name="comment">
                  <ref name="STRING"/>
                </element>
              </optional>
              <optional>
                <element name="inherit_acls">
                  <ref name="STRING"/>
                </element>
              </optional>
              <optional>
                <element name="path">
                  <ref name="STRING"/>
