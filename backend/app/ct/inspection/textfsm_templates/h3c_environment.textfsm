Value SLOT (\d+(?:/\d+){0,2})
Value SENSOR (\S+(?:\s+\d+)?)
Value Required TEMPERATURE (-?\d+(?:\.\d+)?)
Value LOWER_LIMIT (-?\d+(?:\.\d+)?)
Value WARNING_LIMIT (-?\d+(?:\.\d+)?)
Value ALARM_LIMIT (-?\d+(?:\.\d+)?)

Start
  ^\s*${SLOT}\s+${SENSOR}\s+${TEMPERATURE}\s+${LOWER_LIMIT}\s+${WARNING_LIMIT}\s+${ALARM_LIMIT}\s*$$ -> Record
  ^. -> Continue
