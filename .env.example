# OpsToolkit 环境配置示例 - 复制为 .env 并按需修改

# 默认管理员账号
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# JWT 密钥 (生产环境务必修改为随机长字符串)
SECRET_KEY=change-me-in-production-please-use-a-long-random-string

# 数据库 (默认 SQLite)
DATABASE_URL=sqlite+aiosqlite:///./data/ops.db

# 巡检参数
INSPECTION_TIMEOUT=60
INSPECTION_CONCURRENCY=10